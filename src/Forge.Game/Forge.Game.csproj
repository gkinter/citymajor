<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Forge.Engine\Forge.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Forge.SimCore\PopulationGrowthTracker.cs" Link="SimCore\PopulationGrowthTracker.cs" />
    <Compile Include="..\Forge.SimCore\RoadTier.cs" Link="SimCore\RoadTier.cs" />
    <Compile Include="..\Forge.SimCore\TrafficBpr.cs" Link="SimCore\TrafficBpr.cs" />
    <Compile Include="..\Forge.SimCore\CommuteTravelTime.cs" Link="SimCore\CommuteTravelTime.cs" />
    <Compile Include="..\Forge.SimCore\EmergencyResponseTime.cs" Link="SimCore\EmergencyResponseTime.cs" />
    <Compile Include="..\Forge.SimCore\FireResponse.cs" Link="SimCore\FireResponse.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Data\production_chains.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Engine.Tests" />
    <InternalsVisibleTo Include="Forge.Game.Tests" />
    <InternalsVisibleTo Include="Forge.SimCore.Tests" />
  </ItemGroup>
</Project>
