<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="CityPanels.uss" />
    <ui:VisualElement name="budget-root" class="panel-root panel-root--budget" picking-mode="Ignore">
        <ui:Label class="panel-title" text="Budget" />
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Treasury" />
            <ui:Label name="treasury-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Cashflow" />
            <ui:Label name="cashflow-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:Label name="cashflow-detail" class="panel-label" text="" />
        <ui:Label class="panel-section-title" text="Tax rates" />
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Residential" />
            <ui:Label name="tax-res-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Commercial" />
            <ui:Label name="tax-com-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Industrial" />
            <ui:Label name="tax-ind-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:Label class="panel-section-title" text="City health" />
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Approval" />
            <ui:Label name="approval-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Happiness" />
            <ui:Label name="happiness-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Loan" />
            <ui:Label name="loan-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:Label class="panel-section-title" text="Economy" />
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Employment" />
            <ui:Label name="employment-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Trade balance" />
            <ui:Label name="trade-balance-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:Label name="trade-detail" class="panel-detail" text="" />
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Traffic density" />
            <ui:Label name="traffic-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement class="panel-row">
            <ui:Label class="panel-label" text="Constructing" />
            <ui:Label name="constructing-value" class="panel-value" text="—" />
        </ui:VisualElement>
        <ui:Label name="goods-shortage-value" class="panel-detail panel-detail--compact" text="" />
    </ui:VisualElement>
</ui:UXML>
