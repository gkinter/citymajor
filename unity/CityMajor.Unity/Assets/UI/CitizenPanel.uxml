<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="CityPanels.uss" />
    <ui:VisualElement name="citizen-root" class="panel-root panel-root--citizen" style="display: none;">
        <ui:VisualElement class="panel-header">
            <ui:VisualElement>
                <ui:Label name="citizen-title" class="panel-title" text="Citizens" />
                <ui:Label name="citizen-subtitle" class="panel-subtitle" text="Population L2 sample" />
            </ui:VisualElement>
            <ui:Button name="citizen-close" class="panel-close" text="✕" />
        </ui:VisualElement>
        <ui:ScrollView name="citizen-scroll" class="panel-body">
            <ui:VisualElement name="citizen-stats" class="citizen-stats" />
            <ui:Label name="citizen-fallback" class="panel-note" text="" style="display: none;" />
            <ui:Label name="citizen-selected" class="panel-note" text="" style="display: none;" />
            <ui:VisualElement name="citizen-list" class="citizen-list" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
