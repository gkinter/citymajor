.panel-root {
    position: absolute;
    padding: 10px 12px;
    background-color: rgba(12, 16, 24, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    min-width: 200px;
    max-width: 280px;
}

.panel-root--budget {
    top: 12px;
    right: 12px;
}

.panel-root--research {
    top: 12px;
    right: 12px;
    width: 360px;
    max-width: 360px;
    max-height: 80%;
}

.panel-root--save-load {
    bottom: 12px;
    right: 12px;
    top: auto;
    min-width: 168px;
    max-width: 220px;
    padding: 8px 10px;
}

.save-load-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.save-load-btn {
    font-size: 11px;
    color: rgba(230, 235, 245, 0.95);
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    padding: 4px 10px;
    margin-left: 6px;
}

.save-load-status {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.65);
    margin-top: 6px;
    -unity-text-align: middle-right;
}

.panel-root--herald {
    top: 12px;
    right: 12px;
    width: 380px;
    max-width: 380px;
    max-height: 82%;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.panel-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(230, 235, 245);
}

.panel-subtitle {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.65);
    margin-top: 2px;
}

.panel-close {
    font-size: 12px;
    color: rgba(200, 210, 225, 0.85);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 2px 8px;
}

.panel-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(180, 190, 210, 0.75);
    margin-top: 6px;
    margin-bottom: 4px;
}

.panel-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.panel-label {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.7);
}

.panel-value {
    font-size: 11px;
    color: rgb(240, 244, 252);
}

.panel-value--positive {
    color: rgb(125, 255, 178);
}

.panel-value--negative {
    color: rgb(255, 154, 168);
}

.research-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.research-stat {
    flex-direction: row;
    margin-right: 14px;
    margin-bottom: 4px;
}

.research-active {
    margin-bottom: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(89, 153, 255, 0.35);
    background-color: rgba(89, 153, 255, 0.12);
}

.research-progress-track {
    height: 8px;
    background-color: rgba(30, 35, 48, 0.95);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 6px;
}

.research-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(89, 153, 255);
    border-radius: 2px;
}

.research-list {
    flex-grow: 1;
}

.research-list-heading {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(180, 190, 210, 0.8);
    margin-bottom: 6px;
}

.research-item {
    margin-bottom: 6px;
    padding: 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(20, 24, 34, 0.85);
}

.research-item--available {
    border-color: rgba(89, 153, 255, 0.35);
}

.research-item--unlocked {
    opacity: 0.65;
}

.research-item--researching {
    border-color: rgba(242, 204, 64, 0.45);
    background-color: rgba(242, 204, 64, 0.08);
}

.research-item-row {
    flex-direction: row;
    align-items: center;
}

.research-item-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
    flex-grow: 1;
}

.research-item-cost {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.75);
}

.research-item-meta {
    font-size: 9px;
    color: rgba(180, 190, 210, 0.65);
    margin-top: 2px;
    white-space: normal;
}

.research-item-desc {
    font-size: 9px;
    color: rgba(200, 210, 225, 0.55);
    margin-top: 3px;
    white-space: normal;
}

.research-enqueue-btn {
    margin-top: 4px;
    font-size: 10px;
    padding: 2px 6px;
    align-self: flex-start;
}

.herald-body {
    flex-grow: 1;
    max-height: 520px;
}

.herald-status {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.75);
    margin-bottom: 8px;
    white-space: normal;
}

.herald-status--error {
    color: rgb(255, 154, 168);
}

.herald-bucket {
    font-size: 10px;
    color: rgba(180, 190, 210, 0.55);
    -unity-text-align: upper-left;
    margin-bottom: 6px;
}

.herald-reason {
    font-size: 10px;
    color: rgb(125, 200, 255);
    margin-bottom: 8px;
    white-space: normal;
}

.herald-headline {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
    margin-bottom: 10px;
    white-space: normal;
}

.herald-story {
    font-size: 11px;
    color: rgba(220, 228, 240, 0.92);
    white-space: normal;
}

.herald-options {
    margin-top: 16px;
}

.herald-options-heading {
    font-size: 10px;
    color: rgba(180, 190, 210, 0.6);
    margin-bottom: 6px;
}

.herald-option-btn {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(20, 24, 34, 0.9);
    align-items: flex-start;
    white-space: normal;
}

.herald-option-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
    white-space: normal;
}

.herald-option-tradeoff {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.7);
    margin-top: 4px;
    white-space: normal;
}

.hud-hint {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 10px;
    color: rgba(200, 210, 225, 0.55);
    background-color: rgba(12, 16, 24, 0.6);
    padding: 4px 8px;
    border-radius: 4px;
}

.saveload-root {
    bottom: 12px;
    right: 12px;
    top: auto;
    min-width: 160px;
}

.saveload-buttons {
    flex-direction: row;
    margin-bottom: 4px;
}

.saveload-btn {
    margin-right: 6px;
    font-size: 11px;
    padding: 4px 10px;
}
