.panel-root {
    position: absolute;
    padding: 10px 12px;
    background-color: rgba(12, 16, 24, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    min-width: 200px;
    max-width: 280px;
}

.panel-root--budget {
    top: 12px;
    right: 12px;
}

.panel-root--approval {
    top: 186px;
    right: 12px;
    min-width: 200px;
    max-width: 240px;
}

.approval-headline {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 4px;
}

.approval-value {
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.approval-status {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.85);
}

.approval-track {
    height: 6px;
    background-color: rgba(30, 35, 48, 0.95);
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 6px;
}

.approval-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
}

.approval-sub {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.75);
}

.panel-root--research {
    top: 12px;
    right: 12px;
    width: 360px;
    max-width: 360px;
    max-height: 80%;
}

.panel-root--save-load {
    bottom: 12px;
    right: 12px;
    top: auto;
    min-width: 200px;
    max-width: 260px;
    padding: 8px 10px;
}

.panel-root--citizen,
.panel-root--trade,
.panel-root--law,
.panel-root--blueprint {
    top: 12px;
    left: 12px;
    width: 340px;
    max-width: 340px;
    max-height: 78%;
}

.panel-root--blueprint {
    top: auto;
    bottom: 120px;
    left: 12px;
    width: 300px;
    max-width: 300px;
    max-height: 55%;
}

.blueprint-dims {
    margin-bottom: 10px;
}

.blueprint-dim-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: rgba(20, 24, 34, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.blueprint-dim-row Label#label {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.7);
}

.blueprint-dim-row Label#value {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
}

.blueprint-export-btn {
    margin-bottom: 8px;
    font-size: 11px;
    padding: 6px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(89, 153, 255, 0.35);
    background-color: rgba(89, 153, 255, 0.15);
    color: rgb(225, 232, 245);
}

.blueprint-workshop-btn {
    margin-top: 4px;
    margin-bottom: 6px;
    font-size: 10px;
    padding: 4px 10px;
    opacity: 0.5;
}

.panel-root--build {
    top: 12px;
    right: 300px;
    width: 280px;
    max-width: 280px;
    max-height: 70%;
}

.panel-root--help {
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 360px;
    max-width: 360px;
    max-height: 70%;
}

.panel-body {
    flex-grow: 1;
}

.panel-note {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.7);
    margin-bottom: 10px;
    white-space: normal;
    padding: 8px 10px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.panel-note--emphasis {
    -unity-font-style: bold;
    color: rgb(230, 235, 245);
}

.citizen-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.citizen-stat {
    flex-direction: column;
    margin-right: 16px;
    margin-bottom: 6px;
}

.citizen-stat Label {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.65);
}

.citizen-stat Label#value {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
}

.citizen-list {
    flex-grow: 1;
}

.citizen-row {
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(20, 24, 34, 0.85);
    font-size: 10px;
    color: rgb(225, 232, 245);
    white-space: normal;
    align-items: flex-start;
}

.citizen-row--selected {
    border-color: rgba(255, 184, 77, 0.55);
    background-color: rgba(255, 184, 77, 0.1);
}

.ticker-root {
    position: absolute;
    bottom: 48px;
    left: 12px;
    right: 240px;
    padding: 6px 10px;
    background-color: rgba(12, 16, 24, 0.75);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.ticker-line {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.75);
}

.tool-mode-hud {
    position: absolute;
    bottom: 80px;
    left: 12px;
    padding: 4px 10px;
    font-size: 11px;
    color: rgba(220, 228, 240, 0.9);
    background-color: rgba(12, 16, 24, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.happiness-meter {
    position: absolute;
    top: 120px;
    left: 12px;
    width: 160px;
    padding: 8px 12px;
    background-color: rgba(12, 16, 24, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
}

.happiness-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
    margin-bottom: 6px;
}

.happiness-track {
    height: 6px;
    background-color: rgba(8, 12, 24, 0.55);
    border-radius: 3px;
    overflow: hidden;
}

.happiness-fill {
    height: 100%;
    width: 0%;
    border-radius: 3px;
    background-color: rgb(125, 255, 178);
}

.achievement-toast-root {
    position: absolute;
    top: 72px;
    left: 50%;
    margin-left: -160px;
    width: 320px;
    padding: 10px 14px;
    background-color: rgba(18, 24, 36, 0.94);
    border-width: 1px;
    border-color: rgba(255, 214, 102, 0.45);
    border-radius: 8px;
}

.achievement-toast-title {
    font-size: 10px;
    letter-spacing: 0.08em;
    -unity-font-style: bold;
    color: rgba(255, 214, 102, 0.95);
    margin-bottom: 4px;
}

.achievement-toast-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
    margin-bottom: 2px;
}

.achievement-toast-desc {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.85);
}

.time-controls {
    position: absolute;
    bottom: 12px;
    left: 50%;
    translate: -50% 0;
    padding: 4px 12px;
    background-color: rgba(12, 16, 24, 0.8);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.time-controls Label {
    font-size: 11px;
    color: rgb(225, 232, 245);
}

.help-body {
    max-height: 420px;
}

.help-section {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(180, 190, 210, 0.85);
    margin-top: 10px;
    margin-bottom: 4px;
}

.help-line {
    font-size: 10px;
    color: rgba(210, 218, 230, 0.88);
    margin-bottom: 3px;
    white-space: normal;
}

.build-list {
    flex-grow: 1;
}

.build-row {
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(20, 24, 34, 0.85);
    font-size: 10px;
    color: rgb(225, 232, 245);
    white-space: normal;
    align-items: flex-start;
}

.law-list {
    flex-grow: 1;
}

.law-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(20, 24, 34, 0.85);
}

.law-row__name {
    font-size: 11px;
    color: rgb(235, 240, 250);
    flex-grow: 1;
}

.save-load-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.save-load-btn {
    font-size: 11px;
    color: rgba(230, 235, 245, 0.95);
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    padding: 4px 10px;
    margin-left: 6px;
}

.save-load-status {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.65);
    margin-top: 6px;
    -unity-text-align: middle-right;
}

.panel-root--herald {
    top: 12px;
    right: 12px;
    width: 380px;
    max-width: 380px;
    max-height: 82%;
}

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.panel-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(230, 235, 245);
}

.panel-subtitle {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.65);
    margin-top: 2px;
}

.panel-close {
    font-size: 12px;
    color: rgba(200, 210, 225, 0.85);
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 2px 8px;
}

.panel-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(180, 190, 210, 0.75);
    margin-top: 6px;
    margin-bottom: 4px;
}

.panel-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
}

.panel-label {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.7);
}

.panel-value {
    font-size: 11px;
    color: rgb(240, 244, 252);
}

.panel-value--positive {
    color: rgb(125, 255, 178);
}

.panel-value--negative {
    color: rgb(255, 154, 168);
}

.research-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.research-stat {
    flex-direction: row;
    margin-right: 14px;
    margin-bottom: 4px;
}

.research-active {
    margin-bottom: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(89, 153, 255, 0.35);
    background-color: rgba(89, 153, 255, 0.12);
}

.research-progress-track {
    height: 8px;
    background-color: rgba(30, 35, 48, 0.95);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 6px;
}

.research-progress-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(89, 153, 255);
    border-radius: 2px;
}

.research-list {
    flex-grow: 1;
}

.research-list-heading {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgba(180, 190, 210, 0.8);
    margin-bottom: 6px;
}

.research-item {
    margin-bottom: 6px;
    padding: 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(20, 24, 34, 0.85);
}

.research-item--available {
    border-color: rgba(89, 153, 255, 0.35);
}

.research-item--unlocked {
    opacity: 0.65;
}

.research-item--researching {
    border-color: rgba(242, 204, 64, 0.45);
    background-color: rgba(242, 204, 64, 0.08);
}

.research-item-row {
    flex-direction: row;
    align-items: center;
}

.research-item-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
    flex-grow: 1;
}

.research-item-cost {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.75);
}

.research-item-meta {
    font-size: 9px;
    color: rgba(180, 190, 210, 0.65);
    margin-top: 2px;
    white-space: normal;
}

.research-item-desc {
    font-size: 9px;
    color: rgba(200, 210, 225, 0.55);
    margin-top: 3px;
    white-space: normal;
}

.research-enqueue-btn {
    margin-top: 4px;
    font-size: 10px;
    padding: 2px 6px;
    align-self: flex-start;
}

.herald-body {
    flex-grow: 1;
    max-height: 520px;
}

.herald-status {
    font-size: 11px;
    color: rgba(200, 210, 225, 0.75);
    margin-bottom: 8px;
    white-space: normal;
}

.herald-status--error {
    color: rgb(255, 154, 168);
}

.herald-bucket {
    font-size: 10px;
    color: rgba(180, 190, 210, 0.55);
    -unity-text-align: upper-left;
    margin-bottom: 6px;
}

.herald-reason {
    font-size: 10px;
    color: rgb(125, 200, 255);
    margin-bottom: 8px;
    white-space: normal;
}

.herald-headline {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(240, 244, 252);
    margin-bottom: 10px;
    white-space: normal;
}

.herald-story {
    font-size: 11px;
    color: rgba(220, 228, 240, 0.92);
    white-space: normal;
}

.herald-options {
    margin-top: 16px;
}

.herald-options-heading {
    font-size: 10px;
    color: rgba(180, 190, 210, 0.6);
    margin-bottom: 6px;
}

.herald-option-btn {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(20, 24, 34, 0.9);
    align-items: flex-start;
    white-space: normal;
}

.herald-option-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
    white-space: normal;
}

.herald-option-tradeoff {
    font-size: 10px;
    color: rgba(200, 210, 225, 0.7);
    margin-top: 4px;
    white-space: normal;
}

.hud-hint {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-size: 10px;
    color: rgba(200, 210, 225, 0.55);
    background-color: rgba(12, 16, 24, 0.6);
    padding: 4px 8px;
    border-radius: 4px;
}

.saveload-root {
    bottom: 12px;
    right: 12px;
    top: auto;
    min-width: 160px;
}

.saveload-buttons {
    flex-direction: row;
    margin-bottom: 4px;
}

.saveload-btn {
    margin-right: 6px;
    font-size: 11px;
    padding: 4px 10px;
}
