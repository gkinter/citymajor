<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="CityPanels.uss" />
    <ui:VisualElement name="help-root" class="panel-root panel-root--help" style="display: none;">
        <ui:VisualElement class="panel-header">
            <ui:VisualElement>
                <ui:Label name="help-title" class="panel-title" text="Controls" />
                <ui:Label class="panel-subtitle" text="CityMajor Unity v1" />
            </ui:VisualElement>
            <ui:Button name="help-close" class="panel-close" text="✕" />
        </ui:VisualElement>
        <ui:ScrollView class="panel-body help-body">
            <ui:Label class="help-section" text="Zoning &amp; tools" />
            <ui:Label class="help-line" text="1 — Residential · 2 — Commercial · 3 — Industrial · 0 — Erase" />
            <ui:Label class="help-line" text="5 — Office · 6 — Mixed · 7 — Ag · 8 — Park (era / research gated)" />
            <ui:Label class="help-line" text="D — Cycle density Low / Med / High (Med/High era+tech gated)" />
            <ui:Label class="help-line" text="4 — Road paint · X — Bulldoze · B — Build / plop" />
            <ui:Label class="help-line" text="Road toolbar — Local / Collector / Highway · Ramp · Bridge / Tunnel (PlaceRoad)" />
            <ui:Label class="help-section" text="Panels" />
            <ui:Label class="help-line" text="R — Research · H — Herald · C — Citizens · L — Laws" />
            <ui:Label class="help-line" text="E — Economy (goods / production) · G — Politics (approval / council)" />
            <ui:Label class="help-line" text="P — Blueprint · F1 — Help · Esc — Close panel" />
            <ui:Label class="help-line" text="Bottom toolbar — Economy / Politics buttons" />
            <ui:Label class="help-section" text="Overlays" />
            <ui:Label class="help-line" text="V — Service coverage · U — Utility stress · T — Edge traffic heat" />
            <ui:Label class="help-line" text="F — Trade friction corridors (market-zone boundaries)" />
            <ui:Label class="help-line" text="Bottom-center demand — R/C/I + goods shortage + utility stress" />
            <ui:Label class="help-section" text="Time" />
            <ui:Label class="help-line" text="Space — Pause · [ — 1× · ] — 2× · Backslash — 4× (keypad 1/2/4)" />
            <ui:Label class="help-line" text="Cathedral HUD — Commute minutes · O-D coverage · commute satisfaction" />
            <ui:Label class="help-section" text="Camera &amp; pick" />
            <ui:Label class="help-line" text="LMB — Paint active tool / pick citizen on map" />
            <ui:Label class="help-line" text="MMB — Pan camera" />
            <ui:Label class="help-line" text="Bottom-center — R/C/I demand meters" />
            <ui:Label class="help-section" text="Save" />
            <ui:Label class="help-line" text="Bottom-right Save / Load — CMJR v1 local file" />
            <ui:Label class="help-line" text="Share — copies spectator URL stub (v1.5)" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
