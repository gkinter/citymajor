<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ResourcesHud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:Label name="title" class="hud-title" text="CityMajor" />
        <ui:VisualElement class="hud-stats">
            <ui:VisualElement class="hud-stat">
                <ui:Label class="hud-label" text="Pop" />
                <ui:Label name="pop-value" class="hud-value" text="—" />
                <ui:Label name="pop-growth" class="hud-sub" text="" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-stat">
                <ui:Label class="hud-label" text="Funds" />
                <ui:Label name="funds-value" class="hud-value" text="—" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-stat">
                <ui:Label class="hud-label" text="Hour" />
                <ui:Label name="time-value" class="hud-value" text="—" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="utilities-row" class="hud-utilities-row">
            <ui:Label class="hud-label" text="Utilities" />
            <ui:Label name="utilities-value" class="hud-value hud-utilities-value" text="—" />
        </ui:VisualElement>
        <ui:VisualElement name="services-row" class="hud-services-row">
            <ui:Label class="hud-label" text="Services" />
            <ui:Label class="hud-label hud-ems-label" text="EMS" />
            <ui:Label name="ems-value" class="hud-value hud-ems-value" text="—" />
            <ui:Label class="hud-label hud-fire-label" text="Fire" />
            <ui:Label name="fire-value" class="hud-value hud-fire-value" text="—" />
            <ui:Label class="hud-label hud-hospital-label" text="Hosp" />
            <ui:Label name="hospital-value" class="hud-value hud-hospital-value" text="—" />
            <ui:Label class="hud-label hud-police-label" text="Police" />
            <ui:Label name="police-value" class="hud-value hud-police-value" text="—" />
            <ui:Label class="hud-label hud-waste-label" text="Waste" />
            <ui:Label name="waste-value" class="hud-value hud-waste-value" text="—" />
            <ui:Label class="hud-label hud-edu-label" text="Edu" />
            <ui:Label name="edu-value" class="hud-value hud-edu-value" text="—" />
            <ui:Label class="hud-label hud-park-label" text="Park" />
            <ui:Label name="park-value" class="hud-value hud-park-value" text="—" />
        </ui:VisualElement>
        <ui:Label name="cranes-label" class="hud-sub hud-cranes" text="" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>
