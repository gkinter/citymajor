# Session signing for citymajor_uid cookie (required ≥32 chars in production)
CITYMAJOR_SESSION_SECRET=

# Writable data directory for saves/tiers/blobs (default: .data locally, /tmp/citymajor-data in production)
CITYMAJOR_DATA_DIR=

# Stripe — Founder Pass checkout (optional; mock cookie checkout when unset)
# Use test-mode placeholders locally; set real values only in Coolify env (never commit secrets).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_FOUNDER_PASS_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Herald LLM (Founder Pass only; template fallback when unset or on error)
# NARRATIVE_LLM_PROVIDER=openai   # or anthropic — defaults to first key present
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# NARRATIVE_OPENAI_MODEL=gpt-4o-mini
# NARRATIVE_ANTHROPIC_MODEL=claude-3-5-haiku-latest
